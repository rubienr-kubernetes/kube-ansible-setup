apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: "{{ ansible_host }}"
  bindPort: 6443
nodeRegistration:
  name: "{{ final_hostname }}"
  criSocket: unix:///var/run/crio/crio.sock
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: "{{ cluster_name }}"
kubernetesVersion: "{{ kubernetes_version }}"
controlPlaneEndpoint: "{{ kube_api_endpoint }}:6443"
networking:
  dnsDomain: cluster.local
  podSubnet: 10.244.0.0/16
  serviceSubnet: 10.96.0.0/12
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
failSwapOn: true
systemReserved:
  cpu: "{{ kubelet_system_reserved_cpu }}"
  memory: "{{ kubelet_system_reserved_memory }}"
kubeReserved:
  cpu: "{{ kubelet_kube_reserved_cpu }}"
  memory: "{{ kubelet_kube_reserved_memory }}"
evictionHard:
  memory.available: "{{ kubelet_eviction_memory }}"

